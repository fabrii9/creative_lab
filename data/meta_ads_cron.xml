<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_sync_creative_meta_metrics" model="ir.cron">
        <field name="name">Creative Lab: sincronizar métricas Meta</field>
        <field name="model_id" ref="model_creative_publication"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_meta_metrics()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_process_creative_meta_commands" model="ir.cron">
        <field name="name">Creative Lab: procesar órdenes Meta</field>
        <field name="model_id" ref="model_creative_publication"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_meta_commands()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
