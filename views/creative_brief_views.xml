<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_brief_list" model="ir.ui.view">
        <field name="name">creative.brief.list</field>
        <field name="model">creative.brief</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="campaign_id" optional="show"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="creative_count"/>
                <field name="version_count" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="vista_creative_brief_kanban" model="ir.ui.view">
        <field name="name">creative.brief.kanban</field>
        <field name="model">creative.brief</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="creative_count"/>
                <field name="version_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong><field name="name"/></strong>
                            <field name="state" widget="badge"/>
                        </div>
                        <div class="text-muted"><field name="code"/> · <field name="project_id"/></div>
                        <div class="mt-2">
                            <span><field name="creative_count"/> creativos</span>
                            <span class="ms-2"><field name="version_count"/> versiones</span>
                        </div>
                        <footer class="mt-2">
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vista_creative_brief_form" model="ir.ui.view">
        <field name="name">creative.brief.form</field>
        <field name="model">creative.brief</field>
        <field name="arch" type="xml">
            <form string="Brief creativo">
                <header>
                    <button name="action_open_agent_wizard" type="object" string="Ejecutar agente" invisible="state == 'cancelled'"/>
                    <button name="action_mark_ready" type="object" string="Aprobar brief" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Iniciar producción" class="btn-primary" invisible="state not in ['ready', 'review']"/>
                    <button name="action_review" type="object" string="Enviar a revisión" invisible="state != 'in_progress'"/>
                    <button name="action_done" type="object" string="Finalizar" class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ['done', 'cancelled']"/>
                    <button name="action_reset_draft" type="object" string="Volver a borrador" invisible="state not in ['cancelled', 'done']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_hypotheses" type="object" class="oe_stat_button" icon="fa-lightbulb-o">
                            <field name="hypothesis_count" widget="statinfo" string="Hipótesis"/>
                        </button>
                        <button name="action_view_creatives" type="object" class="oe_stat_button" icon="fa-picture-o">
                            <field name="creative_count" widget="statinfo" string="Creativos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Campaña mensajes — Producto A"/></h1>
                        <div><field name="code" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="campaign_id"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="brand_name"/>
                            <field name="expected_action"/>
                            <field name="budget"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Estrategia">
                            <group>
                                <field name="objective" placeholder="Qué resultado comercial buscamos"/>
                                <field name="offer" placeholder="Qué ofrecemos y bajo qué condiciones"/>
                                <field name="target_audience" placeholder="Quién debe ver y responder este anuncio"/>
                            </group>
                            <group string="Investigación">
                                <field name="pains"/>
                                <field name="desires"/>
                                <field name="objections"/>
                                <field name="proof"/>
                            </group>
                        </page>
                        <page string="Marca y límites">
                            <group>
                                <field name="brand_guidelines"/>
                                <field name="constraints"/>
                            </group>
                        </page>
                        <page string="Entrada inicial">
                            <group>
                                <field name="initial_prompt"/>
                                <field name="initial_file" filename="initial_filename"/>
                                <field name="initial_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Hipótesis">
                            <field name="hypothesis_ids" context="{'default_brief_id': id}">
                                <list editable="bottom">
                                    <field name="priority" widget="priority"/>
                                    <field name="name"/>
                                    <field name="segment"/>
                                    <field name="awareness_level"/>
                                    <field name="sophistication_level"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_creative_brief_search" model="ir.ui.view">
        <field name="name">creative.brief.search</field>
        <field name="model">creative.brief</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <filter name="brief_active" string="En curso" domain="[('state', 'in', ['ready', 'in_progress', 'review'])]"/>
                <filter name="brief_done" string="Finalizados" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_project" string="Proyecto" context="{'group_by': 'project_id'}"/>
                <filter name="group_owner" string="Responsable" context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <record id="accion_creative_brief" model="ir.actions.act_window">
        <field name="name">Briefs</field>
        <field name="res_model">creative.brief</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="vista_creative_brief_search"/>
        <field name="context">{'search_default_brief_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá el primer brief creativo</p>
            <p>Definí oferta, público, hipótesis y evidencia antes de generar imágenes.</p>
        </field>
    </record>
</odoo>
