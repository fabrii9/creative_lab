<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_meta_account_list" model="ir.ui.view">
        <field name="name">creative.meta.account.list</field>
        <field name="model">creative.meta.account</field>
        <field name="arch" type="xml">
            <list decoration-success="connection_state == 'ready'" decoration-danger="connection_state == 'error'">
                <field name="name"/>
                <field name="ad_account_id"/>
                <field name="remote_name"/>
                <field name="page_id"/>
                <field name="whatsapp_phone_number"/>
                <field name="currency_id"/>
                <field name="api_version"/>
                <field name="credential_source"/>
                <field name="token_available"/>
                <field name="connection_state" widget="badge"/>
                <field name="publish_enabled"/>
                <field name="activation_enabled"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="vista_creative_meta_account_form" model="ir.ui.view">
        <field name="name">creative.meta.account.form</field>
        <field name="model">creative.meta.account</field>
        <field name="arch" type="xml">
            <form string="Conexión Meta Ads">
                <header>
                    <button name="action_test_connection" type="object" string="Probar conexión" class="btn-primary"
                            groups="creative_lab.grupo_creative_administrador"/>
                    <button name="action_open_credential_wizard" type="object" string="Cargar credenciales"
                            groups="creative_lab.grupo_creative_administrador"/>
                    <button name="action_clear_stored_credentials" type="object" string="Borrar credenciales"
                            groups="creative_lab.grupo_creative_administrador"
                            invisible="not stored_credentials_available"
                            confirm="¿Eliminar el Access Token y el App Secret guardados para esta conexión?"/>
                    <field name="connection_state" widget="statusbar" statusbar_visible="untested,ready,error"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="alert" invisible="credential_source != 'environment'">
                        El token no se guarda en Odoo. Creative Lab lo toma de la variable de entorno indicada.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="credential_source != 'odoo'">
                        Las credenciales se guardan en la base de datos y sus backups. Sólo pueden reemplazarse o eliminarse; nunca se muestran nuevamente en la interfaz.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="credential_source == 'odoo' or not stored_credentials_available">
                        Hay una credencial guardada en Odoo que no está en uso. Podés eliminarla con “Borrar credenciales”.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not activation_enabled">
                        La activación está habilitada: el grupo Activador de Meta podrá iniciar gasto real.
                    </div>
                    <group>
                        <group string="Activos de Meta">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="ad_account_id"/>
                            <field name="page_id"/>
                            <field name="instagram_user_id"/>
                            <field name="whatsapp_phone_number"/>
                            <field name="api_version"/>
                        </group>
                        <group string="Credenciales">
                            <field name="credential_source"/>
                            <field name="token_env_var" invisible="credential_source != 'environment'"/>
                            <field name="app_secret_env_var" invisible="credential_source != 'environment'"/>
                            <field name="token_available" readonly="1"/>
                            <field name="app_secret_available" readonly="1"/>
                            <field name="stored_credentials_available" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Datos verificados">
                        <group>
                            <field name="remote_name"/>
                            <field name="remote_account_status"/>
                            <field name="currency_id"/>
                            <field name="timezone_name"/>
                        </group>
                        <group>
                            <field name="last_test_at"/>
                            <field name="last_error" invisible="not last_error"/>
                        </group>
                    </group>
                    <group string="Controles operativos">
                        <group>
                            <field name="metrics_enabled"/>
                            <field name="publish_enabled"/>
                            <field name="activation_enabled"/>
                        </group>
                        <group>
                            <field name="max_daily_budget"/>
                            <field name="max_lifetime_budget"/>
                            <field name="max_campaign_days"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="accion_creative_meta_account" model="ir.actions.act_window">
        <field name="name">Conexiones Meta Ads</field>
        <field name="res_model">creative.meta.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
