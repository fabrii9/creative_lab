<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.creative.lab</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Creative Lab" string="Creative Lab" name="creative_lab"
                     groups="creative_lab.grupo_creative_administrador">
                    <block title="Flujo de trabajo">
                        <setting string="Modo simple (operador único)"
                                 help="Simplifica el flujo para una sola persona: auto-aprueba versiones, oculta el simulador y fusiona los pasos de publicación."
                                 id="creative_lab_simple_mode_setting">
                            <field name="creative_lab_simple_mode"/>
                        </setting>
                    </block>
                    <block title="Sugerencias con IA"
                           name="creative_lab_suggestions_container">
                        <setting string="Prompts de imagen"
                                 help="Se inyectan en el botón Sugerir con IA del asistente Generar / retocar."
                                 id="creative_lab_suggest_image_setting">
                            <field name="creative_lab_suggest_image_instructions" widget="text"
                                   placeholder="Ej.: estilo sobrio, paleta turquesa y grafito, nunca mostrar precios..."/>
                        </setting>
                        <setting string="Copy del creativo"
                                 help="Se inyectan en el botón Sugerir copy con IA del creativo."
                                 id="creative_lab_suggest_copy_setting">
                            <field name="creative_lab_suggest_copy_instructions" widget="text"
                                   placeholder="Ej.: tono de par a par, sin signos de exclamación, hablar de 'sistema de gestión'..."/>
                        </setting>
                        <setting string="Copy del anuncio Meta"
                                 help="Se inyectan en el botón Sugerir con IA de la publicación."
                                 id="creative_lab_suggest_ad_setting">
                            <field name="creative_lab_suggest_ad_instructions" widget="text"
                                   placeholder="Ej.: cerrar siempre con la oferta del brief, WhatsApp como destino..."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
