<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_export_list" model="ir.ui.view">
        <field name="name">creative.asset.export.list</field>
        <field name="model">creative.asset.export</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="creative_id"/>
                <field name="version_id"/>
                <field name="filename"/>
                <field name="output_format"/>
                <field name="metadata_removed"/>
                <field name="file_size"/>
                <field name="created_by_id" widget="many2one_avatar_user"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="vista_creative_export_form" model="ir.ui.view">
        <field name="name">creative.asset.export.form</field>
        <field name="model">creative.asset.export</field>
        <field name="arch" type="xml">
            <form string="Exportación" create="false" delete="false">
                <header>
                    <button name="action_download" type="object" string="Descargar" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="file" widget="image" class="oe_avatar" filename="filename" options="{'size': [320, 320]}"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="creative_id"/>
                            <field name="version_id"/>
                            <field name="created_by_id" widget="many2one_avatar_user"/>
                            <field name="created_at"/>
                        </group>
                        <group>
                            <field name="filename"/>
                            <field name="mime_type"/>
                            <field name="output_format"/>
                            <field name="quality"/>
                            <field name="metadata_removed"/>
                            <field name="file_size"/>
                            <field name="sha256"/>
                            <field name="fingerprint" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="accion_creative_export" model="ir.actions.act_window">
        <field name="name">Exportaciones</field>
        <field name="res_model">creative.asset.export</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="vista_creative_publication_list" model="ir.ui.view">
        <field name="name">creative.publication.list</field>
        <field name="model">creative.publication</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'active'" decoration-danger="status == 'error'">
                <field name="name"/>
                <field name="creative_id"/>
                <field name="version_id"/>
                <field name="meta_connection_id"/>
                <field name="external_ad_id"/>
                <field name="spend" sum="Gasto"/>
                <field name="impressions" sum="Impresiones"/>
                <field name="clicks" sum="Clics"/>
                <field name="meta_conversation_count" sum="Conversaciones Meta"/>
                <field name="conversation_count" sum="Conversaciones"/>
                <field name="qualified_count" sum="Calificadas"/>
                <field name="meeting_count" sum="Reuniones"/>
                <field name="sale_count" sum="Ventas"/>
                <field name="attributed_revenue" sum="Ingresos"/>
                <field name="status" widget="badge"/>
                <field name="remote_effective_status" widget="badge"/>
                <field name="last_sync_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="vista_creative_publication_form" model="ir.ui.view">
        <field name="name">creative.publication.form</field>
        <field name="model">creative.publication</field>
        <field name="arch" type="xml">
            <form string="Publicación">
                <header>
                    <button name="action_prepare" type="object" string="Preparar" class="btn-primary"
                            groups="creative_lab.grupo_creative_meta_publicador" invisible="status != 'draft' or simple_mode"/>
                    <button name="action_publish_paused" type="object" string="Crear pausada en Meta" class="btn-primary"
                            groups="creative_lab.grupo_creative_meta_publicador"
                            invisible="status not in ['prepared', 'error'] or reconcile_required or simple_mode"/>
                    <button name="action_prepare_and_publish" type="object" string="Crear en Meta (pausada)" class="btn-primary"
                            groups="creative_lab.grupo_creative_meta_publicador"
                            invisible="not simple_mode or status not in ['draft', 'error'] or reconcile_required"/>
                    <button name="action_reconcile_meta" type="object" string="Conciliar con Meta"
                            groups="creative_lab.grupo_creative_meta_publicador" invisible="not reconcile_required"/>
                    <button name="action_sync_meta_metrics" type="object" string="Sincronizar Meta"
                            groups="creative_lab.grupo_creative_meta_publicador" invisible="not external_ad_id"/>
                    <button name="action_activate" type="object" string="Activar en Meta" class="btn-primary"
                            groups="creative_lab.grupo_creative_meta_activador"
                            invisible="status != 'paused' or delivery_pending or reconcile_required"/>
                    <button name="action_pause" type="object" string="Pausar en Meta"
                            groups="creative_lab.grupo_creative_meta_activador"
                            invisible="status != 'active' and remote_configured_status != 'ACTIVE' and not delivery_pending and not (reconcile_required and reconcile_mode == 'delivery' and external_campaign_id)"/>
                    <button name="action_archive" type="object" string="Archivar"
                            groups="creative_lab.grupo_creative_meta_publicador"
                            invisible="status in ['active', 'archived']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,prepared,paused,active,error"/>
                </header>
                <sheet>
                    <field name="simple_mode" invisible="1"/>
                    <div class="alert alert-info" role="status" invisible="not next_step_hint">
                        <field name="next_step_hint" nolabel="1" readonly="1"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not reconcile_required">
                        Meta pudo haber procesado una escritura sin que Odoo recibiera la respuesta. No reintentes la publicación hasta conciliarla.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not delivery_pending">
                        La activación está en una cola durable. La campaña permanece pausada hasta que se valide la jerarquía remota.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not publish_error">
                        <field name="publish_error" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not sync_error">
                        <field name="sync_error" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Pieza aprobada">
                            <field name="creative_id" readonly="status != 'draft'"/>
                            <field name="version_id" domain="[('creative_id', '=', creative_id)]" readonly="status != 'draft'"/>
                            <field name="export_id"
                                   domain="[('version_id', '=', version_id), ('metadata_removed', '=', True)]"
                                   readonly="status != 'draft'"/>
                            <field name="meta_connection_id" domain="[('company_id', '=', company_id), ('active', '=', True)]"
                                   readonly="status != 'draft'"/>
                            <field name="platform" readonly="status != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="ad_currency_id" invisible="1"/>
                        </group>
                        <group string="Presupuesto seguro">
                            <field name="budget_type" readonly="status != 'draft'"/>
                            <field name="daily_budget" invisible="budget_type != 'daily'" readonly="status != 'draft'"/>
                            <field name="lifetime_budget" invisible="budget_type != 'lifetime'" readonly="status != 'draft'"/>
                            <field name="start_at" readonly="status != 'draft'"/>
                            <field name="end_at" readonly="status != 'draft'"/>
                            <field name="sync_enabled"/>
                            <field name="last_sync_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Anuncio y segmentación">
                            <group>
                                <group>
                                    <field name="campaign_objective" readonly="status != 'draft'"/>
                                    <field name="optimization_goal" readonly="status != 'draft'"/>
                                    <field name="billing_event" readonly="status != 'draft'"/>
                                    <field name="destination_type" readonly="status != 'draft'"/>
                                    <field name="special_ad_category" readonly="status != 'draft'"/>
                                    <field name="destination_phone"/>
                                </group>
                                <group>
                                    <field name="headline" readonly="status != 'draft'"/>
                                    <field name="description" readonly="status != 'draft'"/>
                                    <field name="primary_text" readonly="status != 'draft'"/>
                                    <field name="welcome_message" readonly="status != 'draft'"/>
                                </group>
                            </group>
                            <group string="Targeting JSON">
                                <field name="targeting_json" nolabel="1" readonly="status != 'draft'"/>
                            </group>
                        </page>
                        <page string="Meta Ads">
                            <group>
                                <field name="meta_account_id"/>
                                <field name="external_image_hash"/>
                                <field name="external_campaign_id"/>
                                <field name="external_adset_id"/>
                                <field name="external_ad_id"/>
                                <field name="external_creative_id"/>
                                <field name="publish_step"/>
                                <field name="idempotency_key"/>
                                <field name="delivery_pending"/>
                                <field name="reconcile_mode" invisible="not reconcile_required"/>
                                <field name="last_publish_at"/>
                                <field name="remote_configured_status"/>
                                <field name="remote_effective_status"/>
                                <field name="last_sync_attempt_at"/>
                                <field name="remote_issues_json" invisible="not remote_issues_json"/>
                            </group>
                        </page>
                        <page string="Rendimiento">
                            <group>
                                <group>
                                    <field name="spend"/>
                                    <field name="impressions"/>
                                    <field name="reach"/>
                                    <field name="clicks"/>
                                    <field name="inline_link_clicks"/>
                                </group>
                                <group>
                                    <field name="meta_conversation_count"/>
                                    <field name="ctr"/>
                                    <field name="cpc"/>
                                    <field name="cpm"/>
                                    <field name="frequency"/>
                                </group>
                                <group string="Resultados confirmados">
                                    <field name="conversation_count"/>
                                    <field name="qualified_count"/>
                                    <field name="meeting_count"/>
                                    <field name="sale_count"/>
                                    <field name="attributed_revenue"/>
                                </group>
                                <group string="Costos del embudo">
                                    <field name="cost_per_conversation"/>
                                    <field name="cost_per_qualified"/>
                                    <field name="cost_per_sale"/>
                                </group>
                            </group>
                        </page>
                        <page string="Métricas diarias">
                            <field name="metric_ids">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="spend" sum="Gasto"/>
                                    <field name="impressions" sum="Impresiones"/>
                                    <field name="reach" sum="Alcance diario"/>
                                    <field name="clicks" sum="Clics"/>
                                    <field name="inline_link_clicks" sum="Clics enlace"/>
                                    <field name="conversations" sum="Conversaciones Meta"/>
                                    <field name="ctr"/>
                                    <field name="cpc"/>
                                    <field name="cpm"/>
                                    <field name="frequency"/>
                                    <field name="synced_at" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Operaciones Meta">
                            <field name="operation_ids">
                                <list create="false" edit="false" delete="false"
                                      decoration-success="state == 'succeeded'"
                                      decoration-info="state == 'queued'"
                                      decoration-danger="state in ['failed', 'needs_reconcile']">
                                    <field name="started_at"/>
                                    <field name="step"/>
                                    <field name="state" widget="badge"/>
                                    <field name="external_id"/>
                                    <field name="error_code"/>
                                    <field name="error_subcode"/>
                                    <field name="fbtrace_id"/>
                                    <field name="error_message"/>
                                    <field name="finished_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Resultados comerciales">
                            <field name="outcome_ids" context="{'default_publication_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="event_type"/>
                                    <field name="occurred_at"/>
                                    <field name="partner_id"/>
                                    <field name="lead_id"/>
                                    <field name="amount"/>
                                    <field name="source"/>
                                    <field name="confidence"/>
                                    <field name="confirmed"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_creative_publication_search" model="ir.ui.view">
        <field name="name">creative.publication.search</field>
        <field name="model">creative.publication</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="creative_id"/>
                <field name="meta_connection_id"/>
                <field name="external_ad_id"/>
                <filter name="publication_live" string="En Meta" domain="[('status', 'in', ['paused', 'active'])]"/>
                <filter name="publication_active_remote" string="Activas en Meta" domain="[('remote_configured_status', '=', 'ACTIVE')]"/>
                <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                <filter name="group_meta_connection" string="Cuenta Meta" context="{'group_by': 'meta_connection_id'}"/>
                <filter name="group_creative" string="Creativo" context="{'group_by': 'creative_id'}"/>
            </search>
        </field>
    </record>

    <record id="accion_creative_publication" model="ir.actions.act_window">
        <field name="name">Publicaciones</field>
        <field name="res_model">creative.publication</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vista_creative_publication_search"/>
    </record>

    <record id="vista_creative_outcome_list" model="ir.ui.view">
        <field name="name">creative.outcome.list</field>
        <field name="model">creative.outcome</field>
        <field name="arch" type="xml">
            <list decoration-muted="not confirmed">
                <field name="occurred_at"/>
                <field name="name"/>
                <field name="publication_id"/>
                <field name="creative_id"/>
                <field name="event_type" widget="badge"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="amount" sum="Ingresos"/>
                <field name="source"/>
                <field name="confidence"/>
                <field name="confirmed"/>
            </list>
        </field>
    </record>

    <record id="vista_creative_outcome_form" model="ir.ui.view">
        <field name="name">creative.outcome.form</field>
        <field name="model">creative.outcome</field>
        <field name="arch" type="xml">
            <form string="Resultado atribuible">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="publication_id"/>
                            <field name="creative_id" readonly="1"/>
                            <field name="version_id" readonly="1"/>
                            <field name="event_type"/>
                            <field name="occurred_at"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="amount" invisible="event_type != 'sale'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="confirmed"/>
                        </group>
                    </group>
                    <group string="Atribución y evidencia">
                        <field name="source"/>
                        <field name="confidence"/>
                        <field name="whatsapp_message_id"/>
                        <field name="referral_ad_id"/>
                        <field name="evidence"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_creative_outcome_search" model="ir.ui.view">
        <field name="name">creative.outcome.search</field>
        <field name="model">creative.outcome</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="publication_id"/>
                <field name="creative_id"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <filter name="outcome_confirmed" string="Confirmados" domain="[('confirmed', '=', True)]"/>
                <filter name="group_event" string="Evento" context="{'group_by': 'event_type'}"/>
                <filter name="group_creative" string="Creativo" context="{'group_by': 'creative_id'}"/>
                <filter name="group_source" string="Fuente" context="{'group_by': 'source'}"/>
            </search>
        </field>
    </record>

    <record id="accion_creative_outcome" model="ir.actions.act_window">
        <field name="name">Resultados</field>
        <field name="res_model">creative.outcome</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vista_creative_outcome_search"/>
    </record>
</odoo>
