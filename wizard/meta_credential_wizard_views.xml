<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_meta_credential_wizard_form" model="ir.ui.view">
        <field name="name">creative.meta.credential.wizard.form</field>
        <field name="model">creative.meta.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="Guardar credenciales de Meta">
                <div class="alert alert-warning" role="alert">
                    Las credenciales quedarán guardadas en la base de datos de Odoo y estarán incluidas en sus backups. No podrán volver a leerse desde esta pantalla.
                    Al guardarlas, esta conexión pasará a usar “Guardadas en Odoo”.
                </div>
                <group>
                    <field name="meta_account_id"/>
                    <field name="access_token" password="True"/>
                    <field name="app_secret" password="True"/>
                    <field name="clear_app_secret" invisible="app_secret"/>
                </group>
                <footer>
                    <button name="action_save_credentials" type="object" string="Guardar credenciales" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
