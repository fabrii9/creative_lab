<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_asset_export_wizard_form" model="ir.ui.view">
        <field name="name">creative.asset.export.wizard.form</field>
        <field name="model">creative.asset.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar activo">
                <group>
                    <field name="version_id"/>
                    <field name="output_format"/>
                    <field name="quality" invisible="output_format not in ['jpeg', 'webp']"/>
                    <field name="strip_metadata"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Crear exportación" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
