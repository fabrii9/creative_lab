<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_generate_wizard_form" model="ir.ui.view">
        <field name="name">creative.generate.wizard.form</field>
        <field name="model">creative.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar o retocar creativo">
                <group>
                    <field name="creative_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="operation"/>
                    <field name="source_version_id" invisible="operation == 'initial'"/>
                    <field name="agent_profile_id" invisible="operation == 'import'"/>
                </group>
                <group string="Instrucción" invisible="operation == 'import'">
                    <field name="prompt" placeholder="Describí qué generar o qué debe cambiar..."/>
                    <field name="negative_prompt" placeholder="Elementos que el modelo debe evitar..."/>
                </group>
                <group string="Archivo fuente">
                    <field name="input_file" filename="input_filename"/>
                    <field name="input_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generar" class="btn-primary" invisible="operation == 'import'"/>
                    <button name="action_generate" type="object" string="Importar" class="btn-primary" invisible="operation != 'import'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
