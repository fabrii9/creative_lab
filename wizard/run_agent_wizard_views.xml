<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_creative_agent_run_wizard_form" model="ir.ui.view">
        <field name="name">creative.agent.run.wizard.form</field>
        <field name="model">creative.agent.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Ejecutar agente">
                <group>
                    <field name="brief_id"/>
                    <field name="creative_id"/>
                    <field name="source_version_id" invisible="not creative_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="profile_id"/>
                    <field name="operation"/>
                </group>
                <group string="Pedido">
                    <field name="prompt" placeholder="Ej. Proponé tres ángulos separados por nivel de conciencia"/>
                    <field name="input_file" filename="input_filename"/>
                    <field name="input_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Ejecutar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
